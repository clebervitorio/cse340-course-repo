<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <%= project.date.toLocaleDateString('en-US', { dateStyle: 'long' }) %>:
                <strong><a href="/project/<%= project.project_id %>"><%= project.title %></a></strong>
                (<em><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></em>)
            </li>
        <% }); %>
    </ul>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-project">Add a New Service Project</a></p>
    <% } %>
            
</main>

<%- include('partials/footer') %>